const denominations = [
	{ label: "$0.5, $1, $2", key: "c1_2" },
	{ label: "$5", key: "c5" },
	{ label: "$10", key: "c10" },
	{ label: "$20", key: "c20" },
	{ label: "$50", key: "c50" },
	{ label: "$100", key: "c100" },
	{ label: "$200", key: "c200" },
	{ label: "$500", key: "c500" },
	{ label: "$1,000", key: "c1000" },
];

const dejar = {
	c1_2: "",
	c5: "",
	c10: "",
	c20: "",
	c50: "",
	c100: "",
	c200: "",
	c500: "",
	c1000: "",
};

const guardar = {
	c1_2: "",
	c5: "5",
	c10: "10",
	c20: "2",
	c50: "",
	c100: "",
	c200: "",
	c500: "1",
	c1000: "",
};

const sum = denominations.reduce((total, denomination, index) => {
	const key = denomination.key;
	const value = parseFloat(guardar[key]) || 0;

	let multiplier;

	index === 0
		? (multiplier = 1)
		: // Remove "$" and "," from label and convert to number
		  (multiplier = parseFloat(denomination.label.replace(/[$,]/g, "")));

	return total + value * multiplier;
}, 0);

